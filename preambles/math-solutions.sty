\RequirePackage{math-solutions-colors}      % 颜色配置
\RequirePackage{math-solutions-layout}      % 页面布局配置
\RequirePackage{math-solutions-math}        % 数学字体配置
\RequirePackage{math-solutions-floats}      % 浮动体配置
\RequirePackage{math-solutions-tcb}         % tcolorbox配置
\RequirePackage{math-solutions-env}         % 自定义环境配置
\RequirePackage{math-solutions-ref}         % 交叉引用与参考文献配置

