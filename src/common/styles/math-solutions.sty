\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{math-solutions}

% 预配置
\PassOptionsToPackage{no-math}{fontspec}
\PassOptionsToPackage{partial=upright}{unicode-math}

% 基础与工具宏包
\RequirePackage{import}              % 支持相对路径导入文件
\RequirePackage[
    dvipsnames,
    svgnames
]{xcolor}                            % 颜色支持

\definecolor{ThemeDarkBlue}{RGB}{71, 85, 142}    % 深藏青
\definecolor{ThemeMidBlue}{RGB}{105, 130, 185}   % 灰蓝
\definecolor{ThemeLightBlue}{RGB}{188, 202, 224} % 雾蓝
\definecolor{ThemePaper}{RGB}{241, 239, 236}     % 米白
\definecolor{ThemeRose}{RGB}{174, 107, 129}      % 绛粉
\definecolor{ThemeWine}{RGB}{130, 45, 74}        % 藏红

\colorlet{ThemePaperLight}{ThemePaper!40!white}
\pagecolor{ThemePaperLight}

\colorlet{MainTextColor}{ThemeDarkBlue!50!black}
\AtBeginDocument{\color{MainTextColor}}

% 页面布局与几何设置
\RequirePackage[
    inner=1.5cm,
    outer=1.5cm,
    top=2cm,
    bottom=1.5cm,
    marginparwidth=2cm,
    marginparsep=0.4cm,
    includehead,
    includefoot,
    heightrounded
]{geometry}

% \raggedbottom                      % 允许页面底部不对齐，避免过度拉伸垂直间距

\RequirePackage{titlesec}            % 标题格式定制
\newcommand{\sectionbreak}{\clearpage}

\ctexset{
    chapter = {
      % 标题整体居左
      format = \huge\bfseries\color{ThemeDarkBlue},
      name = {第,章},
      % 章编号：使用藏红，加宽一点间距
      number = \textcolor{ThemeWine}{\thechapter},
      aftername = \hspace{1em},
      % 在章标题下方绘制装饰线
      aftertitle = {
              \par\vspace{0.5em}
              {\color{ThemeWine}\hrule height 2pt}
              \vspace{0.2em}
              {\color{ThemeRose}\hrule height 0.5pt}
          },
      beforeskip = {-10pt}, % 向上微调，减少顶部留白
      afterskip = {30pt}    % 与正文保持一定距离
     },
    section = {
      format = \Large\bfseries\color{ThemeDarkBlue},
      name = {第,节},
      number = \textcolor{ThemeWine}{\thesection},
      aftername = \hspace{0.5em}
     },
    subsection = {
            format = \large\bfseries\color{ThemeWine}, % 子标题直接用藏红
            indent = 0pt
        }
}



% 数学与物理核心宏包
\RequirePackage{amsmath}             % AMS 数学核心
\RequirePackage{amsthm}              % AMS 定理环境
\RequirePackage{amssymb}             % AMS 数学符号
\RequirePackage{amsfonts}            % AMS 数学字体

\RequirePackage{unicode-math}        % Unicode 数学字体支持
% 设置数学字体为 Latin Modern Math
% \setmathfont{latinmodern-math.otf}
% 设置数学字体为 New Computer Modern Math（更现代的设计）
\setmathfont{NewCMMath-Book.otf}
% 设置数学字体为 STIX Two Math（科学出版物常用的字体，清晰且专业）
% \setmathfont{STIXTwoMath-Regular.otf}
% \setmathfont{texgyretermes-math.otf}

% 常用正体符号定义
\newcommand{\e}{\symup{e}}           % 自然对数底
\newcommand{\uppi}{\symup{\pi}}      % 圆周率
\newcommand{\ii}{\symup{i}}          % 虚数单位

% 符号扩展
\RequirePackage{fixdif}              % 完美的微分算子格式修正

\newfontfamily\emojifont{Noto Color Emoji}[Renderer=Harfbuzz]

% 图形与表格
\RequirePackage{memoize}             % 结果缓存，避免重复计算（如复杂图形或表格生成）
\mmzset{
    prefix=memo-cache/,
    auto={problem}{nomemoize},
    auto={note}{nomemoize},
    auto={tikzpicture}{memoize},
    auto={axis}{memoize}
}

\RequirePackage{graphicx}            % 图片插入
\RequirePackage{float}               % 浮动体控制（H 选项）
\RequirePackage{caption}             % 图表标题定制

\RequirePackage{tikz}                % 绘图工具
\usetikzlibrary{arrows.meta, angles, quotes, calc, patterns}

\RequirePackage{pgfplots}
\pgfplotsset{compat=1.18}

\RequirePackage{tabularray}          % 现代表格宏包
\RequirePackage{booktabs}            % 三线表
\RequirePackage{multirow}            % 跨行单元格
\RequirePackage{scalerel}            % 符号缩放
\RequirePackage{enumitem}

% 多栏与彩色盒子
\RequirePackage{multicol}            % 多栏环境
\RequirePackage{tcolorbox}           % 彩色文本框
\tcbuselibrary{skins, breakable, theorems}

% 参考文献管理
\RequirePackage[
    backend=biber,
    style=gb7714-2015,
    sorting=none,
    backref=true
]{biblatex}

% 交叉引用与超链接（加载顺序：hyperref -> bookmark -> cleveref）
\RequirePackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=ThemeDarkBlue,
    citecolor=ThemeRose,
    urlcolor=ThemeWine,
    bookmarksnumbered=true,
    pdfstartview=FitH
}
\RequirePackage{bookmark}            % 书签增强

\RequirePackage{cleveref}            % 智能交叉引用
\crefname{equation}{公式}{公式}
\Crefname{equation}{公式}{公式}


% 解析环境配置
\allowdisplaybreaks[2] % 允许在多行公式中断页，级别 2 是适度允许

\setlist[enumerate,1]{
    label=(\arabic*),
    leftmargin=2.6em,
    itemsep=0.25ex,
    topsep=0.5ex,
    parsep=0pt,
    partopsep=0pt
}

\NewDocumentEnvironment{solution}{}%
{\par\smallskip\noindent\textbf{解}\par\noindent\ignorespaces}%
{\par\noindent\hfill$\blacksquare$\par\smallskip}

\NewDocumentEnvironment{myproof}{}%
{\par\smallskip\noindent\textbf{证明}\par\noindent\ignorespaces}%
{\par\noindent\hfill$\square$\par\smallskip}

% 解答中按子问给出答案
\newcommand{\ansitem}[1]{%
    \par\smallskip\noindent{(#1)}\quad\ignorespaces
}

% tcb配置
% 基础样式定义
\tcbset{
    my_base_style/.style={
            enhanced,
            breakable,
            boxrule=0.6pt,
            arc=2mm,
            outer arc=2mm,
            top=1.2em,            % 为悬浮标题留出顶部空间
            colupper=MainTextColor,
            fonttitle=\heiti,
            description font=\normalfont\kaishu,
            separator sign none,  % 移除默认冒号
            description delimiters={---}{}, % 自动包裹描述
            colback=ThemePaper!80!white,   % 统一使用米白混合20%的白色，保持整体风格一致
            % 标题框设置
            attach boxed title to top left={xshift=3mm, yshift=-3mm, yshifttext=-1mm},
            boxed title style={
                    boxrule=0.5pt,
                    arc=1mm,
                },
            % 虚线分割线设置
            segmentation style={dash pattern=on 3pt off 2pt, opacity=0.5}
        }
}

% 习题环境 (Problem): 深蓝/灰蓝配色
\newtcbtheorem[number within=section]{problem}{习题}{
    my_base_style,
    colframe=ThemeDarkBlue,          % 边框深蓝色
    colbacktitle=ThemeDarkBlue,      % 标题背景深蓝色
    coltitle=white,                  % 标题文字白色
    boxed title style={colframe=ThemeDarkBlue},
    segmentation style={ThemeMidBlue}
}{prob}

% 注释环境 (Note): 绛粉/藏红配色
\newtcbtheorem[number within=section]{note}{注释}{
    my_base_style,
    colframe=ThemeRose,              % 边框绛粉色
    colbacktitle=ThemeRose!10!ThemePaper, % 标题背景淡淡的粉色 (浅化处理)
    coltitle=ThemeWine,              % 标题文字使用深红，保证对比度
    boxed title style={colframe=ThemeRose},
    segmentation style={ThemeRose}
}{note}


% 页眉页脚设定 (fancyhdr)
\RequirePackage{fancyhdr}
\RequirePackage{zhnumber} % 用于中文页码（可选）

\setlength{\headheight}{18pt}     % 直接设置足够的高度，消除警告
\addtolength{\topmargin}{-3.5pt}  % 相应地把顶边距往上提一点，保持视觉平衡
\pagestyle{fancy}
\fancyhf{}

% 页码：使用藏红 ThemeWine，加粗
\fancyhead[LE]{\fontsize{10.5pt}{12pt}\selectfont\color{ThemeWine}\bfseries\thepage}
% 章标题：使用深蓝色
\fancyhead[RE]{\fontsize{10.5pt}{12pt}\selectfont\color{ThemeDarkBlue}\leftmark}

% 节标题：使用深蓝色
\fancyhead[LO]{\fontsize{10.5pt}{12pt}\selectfont\color{ThemeDarkBlue}\rightmark}
% 页码：使用藏红 ThemeWine
\fancyhead[RO]{\fontsize{10.5pt}{12pt}\selectfont\color{ThemeWine}\bfseries\thepage}

% 重新定义 headrule，使其带颜色并有粗细变化
\renewcommand{\headrule}{
    {\color{ThemeWine}\hrule width\headwidth height 1.5pt} % 主色线
    \vspace{1pt}
    {\color{ThemeRose}\hrule width\headwidth height 0.5pt} % 辅助细线（绛粉）
}
\renewcommand{\footrulewidth}{0pt}

% 标记格式化
\renewcommand{\chaptermark}[1]{%
    \markboth{\color{ThemeRose}\if@mainmatter\CTEXthechapter\quad\fi\color{ThemeDarkBlue}#1}{}%
}

% 节标记：将 § 符号设为绛粉色 ThemeRose
\renewcommand{\sectionmark}[1]{%
    \markright{\color{ThemeRose}\S\thesection\quad\color{ThemeDarkBlue}#1}%
}

% 目录排版优化
\renewcommand\tableofcontents{%
    \chapter*{\contentsname}%
    \@mkboth{\MakeUppercase\contentsname}{\MakeUppercase\contentsname}%
    \begin{multicols}{2}
        \@starttoc{toc}%
    \end{multicols}
}

% 警告控制规范化
